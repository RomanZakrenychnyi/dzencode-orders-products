{
  "name": "dzencode-orders-products",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "setup:auth": "npm run setup:auth --workspace=@orders-products/api",
    "test:auth": "npm run test:auth --workspace=@orders-products/api",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:status": "docker compose ps",
    "db:logs": "docker compose logs --tail=100 db",
    "dev": "npm run dev --workspace=@orders-products/web",
    "dev:api": "npm run dev --workspace=@orders-products/api",
    "build:api": "npm run build --workspace=@orders-products/api",
    "start:api": "npm run start --workspace=@orders-products/api",
    "typecheck:api": "npm run typecheck --workspace=@orders-products/api",
    "build": "npm run build --workspace=@orders-products/web",
    "start": "npm run start --workspace=@orders-products/web",
    "typecheck": "npm run typecheck --workspace=@orders-products/web"
  }
}
