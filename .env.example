# Local development only. Use separate strong credentials for deployment.
DB_PORT=3307
DB_PASSWORD=orders_local_password
DB_ROOT_PASSWORD=orders_local_root_password

# Docker Compose: generate a secret before first launch.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoPass123!
WEB_PORT=3000
API_PORT=4000
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Local HTTP only; set true when deploying with HTTPS.
COOKIE_SECURE=false
